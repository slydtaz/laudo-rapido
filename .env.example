# Banco de dados (Postgres gerenciado)
DATABASE_URL=

# Cloudflare R2 (armazenamento de fotos)
# O bucket deve ter acesso público habilitado (URLs r2.dev) para que fotos e assinatura apareçam no PDF e no link público.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend (envio de e-mail com o PDF)
RESEND_API_KEY=

# Segredo de assinatura de sessão (não usado atualmente pela auth de tokens opacos no banco; mantenha com 32+ bytes)
SESSION_SECRET=
